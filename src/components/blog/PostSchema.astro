---
import { SITE } from 'astrowind:config';
import type { ImageMetadata } from 'astro';
import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
  image?: ImageMetadata | string;
}

const { post, url, image } = Astro.props;

const rawImage = typeof image === 'string' ? image : image?.src;
const resolvedImage = rawImage ? new URL(rawImage, SITE.site).toString() : undefined;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: new Date(post.publishDate).toISOString(),
  ...(post.updateDate ? { dateModified: new Date(post.updateDate).toISOString() } : {}),
  ...(resolvedImage ? { image: [resolvedImage] } : {}),
  author: {
    '@type': 'Person',
    name: post.author || SITE?.name,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE?.name,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', SITE.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': String(url),
  },
  ...(post.category ? { articleSection: post.category.title } : {}),
  ...(post.tags?.length ? { keywords: post.tags.map((t) => t.title).join(', ') } : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />