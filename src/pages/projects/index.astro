---
import Layout from '~/layouts/PageLayout.astro';
import { getProjects } from '~/utils/projects';
import { findImage } from '~/utils/images';
import Image from '~/components/common/Image.astro';

export const prerender = true;

const metadata = { title: 'Projects' };
const projects = await getProjects();
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <div class="mb-10 md:mb-14 text-center">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading dark:text-gray-200">
        Projects
      </h1>
      <p class="mt-4 text-xl text-muted dark:text-slate-400 max-w-2xl mx-auto">
        Ongoing series and deep dives grouping related posts into focused explorations of a topic.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      {
        projects.map(async (project) => {
          const image = await findImage(project.image);
          return (
            <a
              href={`/projects/${project.slug}`}
              class="group block rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 hover:border-primary dark:hover:border-blue-500 transition-colors"
            >
              {image && (
                <div class="relative h-48 bg-gray-100 dark:bg-slate-800">
                  <Image
                    src={image}
                    class="w-full h-full object-cover"
                    widths={[400, 800]}
                    sizes="(max-width: 767px) 400px, 800px"
                    width={800}
                    height={450}
                    format="webp"
                    alt={project.title}
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center justify-between mb-2">
                  <h2 class="text-xl font-bold dark:text-slate-200 group-hover:text-primary dark:group-hover:text-blue-400 transition-colors">
                    {project.title}
                  </h2>
                  {project.status && (
                    <span
                      class={`text-xs font-semibold px-2 py-0.5 rounded-full ${
                        project.status === 'active'
                          ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400'
                          : project.status === 'complete'
                            ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400'
                            : 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400'
                      }`}
                    >
                      {project.status}
                    </span>
                  )}
                </div>
                {project.description && (
                  <p class="text-muted dark:text-slate-400 text-sm mb-4 line-clamp-3">{project.description}</p>
                )}
                <div class="flex flex-wrap gap-1.5">
                  {(project.technologies ?? []).map((tech) => (
                    <span class="text-xs bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 px-2 py-0.5 rounded">
                      {tech}
                    </span>
                  ))}
                </div>
                <p class="mt-4 text-xs text-muted dark:text-slate-500">
                  {project.resolvedPosts?.length ?? 0} post{(project.resolvedPosts?.length ?? 0) !== 1 ? 's' : ''}
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</Layout>
