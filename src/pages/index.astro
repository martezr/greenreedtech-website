---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Green Reed Technology — Technology Blog & Portfolio',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Green Reed Technology"
    actions={[
      { variant: 'primary', text: 'Read the Blog', href: '/blog', icon: 'tabler:book' },
      { text: 'About Me', href: '/about' },
    ]}
  >
    <Fragment slot="title">
      Exploring tech at the<br />
      <span class="text-accent dark:text-white highlight">intersection of automation,</span><br />
      infrastructure, and cloud
    </Fragment>

    <Fragment slot="subtitle">
      I'm <span class="font-semibold">Martez Reed</span> — tech enthusiast, blogger, and speaker.
      I write about Automation & Orchestration, HashiCorp tools, VMware, Hybrid Cloud and everything in between.
    </Fragment>
  </Hero>

  <BlogLatestPosts
    title="Latest Articles"
    information="Practical guides, deep dives, and insights on automation, infrastructure, and cloud technologies."
    linkText="View all posts"
    linkUrl="/blog"
  />

  <Features2
    title="What I Write About"
    subtitle="Topics spanning the breadth of modern infrastructure and platform engineering."
    columns={3}
    items={[
      {
        title: 'DevOps & Automation',
        description: 'CI/CD pipelines, infrastructure as code, StackStorm, Argo Workflows, and modern delivery practices.',
        icon: 'tabler:rocket',
      },
      {
        title: 'HashiCorp Ecosystem',
        description: 'Vault, Terraform, Nomad, and Packer — security, provisioning, and orchestration at scale.',
        icon: 'tabler:lock',
      },
      {
        title: 'Private Cloud',
        description: 'Private cloud, container hosts, event-driven automation with VEBA, and workload identity.',
        icon: 'tabler:server',
      },
      {
        title: 'Kubernetes & Containers',
        description: 'KubeVirt, containerization strategies, and cloud-native application patterns.',
        icon: 'tabler:brand-docker',
      },
      {
        title: 'Security & Compliance',
        description: 'Vault hardening, policy management, audit logging, and supply chain security.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Cloud & Infrastructure',
        description: 'AWS, Terraform state management, networking, and storage for modern workloads.',
        icon: 'tabler:cloud',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>
</Layout>
