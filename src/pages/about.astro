---
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Martez Reed',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="About Me"
    image={{
      src: '/images/martezreed.jpg',
      alt: 'Martez Reed',
    }}
  >
    <Fragment slot="title">
      Hi, I'm <span class="text-accent dark:text-white">Martez Reed</span>
    </Fragment>

    <Fragment slot="subtitle">
      A technologist with a passion for automation, infrastructure, and helping organizations
      navigate the evolving landscape of hybrid cloud technologies.
    </Fragment>
  </Hero>

  <Content
    isReversed
    items={[
      {
        title: 'Systems & Infrastructure',
        description: 'Deep background in system administration evolving into modern platform and infrastructure engineering.',
        icon: 'tabler:server',
      },
      {
        title: 'Automation & Orchestration',
        description: 'Hands-on experience with StackStorm, Jenkins, Ansible, Chef, and Puppet across enterprise environments.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Technical Marketing',
        description: 'Translating complex technical concepts into compelling content, demos, and enablement for practitioners.',
        icon: 'tabler:writing',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Technology workspace',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Background</h3>
      I'm currently the Vice President of Field Solutions for RiverMeadow Software, focused on helping partners and customers understand how to leverage the RiverMeadow platform to enable workload mobility, optimization, and modernization. My career spans client-facing consulting, DevOps initiatives, and helping
      organizations modernize their infrastructure practices.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Features2
    title="Technical Expertise"
    subtitle="Technologies and platforms I write about and work with."
    columns={3}
    items={[
      {
        title: 'HashiCorp Stack',
        description: 'Vault, Terraform, Nomad, Packer — secrets management, IaC, and workload scheduling.',
        icon: 'tabler:lock',
      },
      {
        title: 'VMware / vSphere',
        description: 'Private cloud, VEBA event-driven automation, workload identity, and container hosts.',
        icon: 'tabler:server-2',
      },
      {
        title: 'Kubernetes',
        description: 'Container orchestration, KubeVirt, cloud-native patterns, and platform engineering.',
        icon: 'tabler:brand-docker',
      },
      {
        title: 'CI/CD & DevOps',
        description: 'Jenkins, GitOps, Argo Workflows, pipeline design, and chaos engineering.',
        icon: 'tabler:git-merge',
      },
      {
        title: 'Security & Compliance',
        description: 'Vault hardening, Chef InSpec, audit logging, supply chain security, and policy management.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Configuration Management',
        description: 'Puppet, Chef, Ansible — policy-based autosigning, bolt provisioners, and inventory plugins.',
        icon: 'tabler:settings',
      },
    ]}
  />

  <Steps2
    title="Speaking Engagements"
    subtitle="I've had the privilege of speaking at DevOpsDays events and VMware User Groups across the country."
    items={[
      {
        title: 'DevOpsDays Indianapolis',
        description: '2018 & 2019',
        icon: 'tabler:microphone',
      },
      {
        title: 'DevOpsDays Raleigh',
        description: '2019',
        icon: 'tabler:microphone',
      },
      {
        title: 'DevOpsDays Minneapolis',
        description: '2019',
        icon: 'tabler:microphone',
      },
      {
        title: 'DevOpsDays Chicago',
        description: '2018',
        icon: 'tabler:microphone',
      },
      {
        title: 'Indy VMUG UserCon',
        description: '2017, 2018 & 2021',
        icon: 'tabler:microphone',
      },
      {
        title: 'Chicago VMUG UserCon',
        description: '2018',
        icon: 'tabler:microphone',
      },
      {
        title: 'ChefConf',
        description: '2018',
        icon: 'tabler:microphone',
      },
      {
        title: 'Cloud Field Day 3',
        description: 'Tech Field Day Delegate',
        icon: 'tabler:microphone',
      },
    ]}
  />

  <Features2
    title="Connect"
    columns={3}
    items={[
      {
        title: 'GitHub',
        description: 'github.com/martezr',
        icon: 'tabler:brand-github',
      },
      {
        title: 'LinkedIn',
        description: 'linkedin.com/in/martezreed',
        icon: 'tabler:brand-linkedin',
      },
      {
        title: 'X / Twitter',
        description: '@greenreedtech',
        icon: 'tabler:brand-x',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>
</Layout>
